# FastAPI base URL (no trailing slash)
EXPO_PUBLIC_MIST_API_URL=http://127.0.0.1:8000

# When the Python API is started with API_KEYS=... (see src/api/security.py)
# EXPO_PUBLIC_MIST_API_KEY=

# Sign in with Google — OAuth 2.0 client IDs from Google Cloud Console.
# The API must set GOOGLE_OAUTH_CLIENT_IDS to the same client ID(s) (comma-separated).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
